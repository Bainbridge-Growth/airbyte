{
  "documentationUrl": "https://docs.airbyte.com/integrations/sources/quickbooks",
  "connectionSpecification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Quickbooks Drivepoint Spec",
    "type": "object",
    "required": ["company_id", "client_id", "client_secret", "accounting_method"],
    "additionalProperties": true,
    "properties": {
      "company_id": {
        "order": 0,
        "title": "Drivepoint Company ID",
        "type": "string",
        "description": "The ID of the company in Drivepoint App",
        "group": "base_settings"
      },
      "client_id": {
        "order": 1,
        "title": "Client ID",
        "type": "string",
        "description": "The Client ID of your developer application",
        "airbyte_secret": true,
        "group": "base_settings"
      },
      "client_secret": {
        "order": 2,
        "title": "Client Secret",
        "type": "string",
        "description": "The client secret of your developer application",
        "airbyte_secret": true,
        "group": "base_settings"
      },
      "accounting_method": {
        "order": 3,
        "title": "Accounting Method",
        "description": "The accounting method used to generate the report. This can be either Accrual or Cash. If not specified, the default is Accrual.",
        "type": "object",
        "display_type": "radio",
        "group": "base_settings",
        "oneOf": [
          {
            "title": "Accrual",
            "required": ["selected_method"],
            "properties": {
              "selected_method": {
                "type": "string",
                "const": "Accrual",
                "order": 0
              }
            }
          },
          {
            "title": "Cash",
            "required": ["selected_method"],
            "properties": {
              "selected_method": {
                "type": "string",
                "const": "Cash",
                "order": 1
              }
            }
          }
        ]
      },
      "balance_sheet_settings": {
        "order": 4,
        "title": "Balance Sheet Report settings",
        "type": "object",
        "group": "balance_sheet_settings",
        "properties": {
          "summarize_column": {
            "title": "Summarize Column By",
            "description": "The first dimension criteria which defines how to group the report results.",
            "type": "object",
            "display_type": "dropdown",
            "order": 1,
            "oneOf": [
              {
                "title": "None",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "None",
                    "order": 0
                  }
                }
              },
              {
                "title": "Departments",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Departments",
                    "order": 1
                  }
                }
              },
              {
                "title": "Classes",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Classes",
                    "order": 2
                  }
                }
              },
              {
                "title": "Customers",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Customers",
                    "order": 3
                  }
                }
              },
              {
                "title": "Vendors",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Vendors",
                    "order": 4
                  }
                }
              }
            ]
          },
          "second_dimension": {
            "title": "Second Dimension",
            "description": "Secondary dimension to further break down the report results. Requires Summarize Column By to be set to a value other than None.",
            "type": "object",
            "display_type": "dropdown",
            "order": 2,
            "oneOf": [
              {
                "title": "None",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "None",
                    "order": 0
                  }
                }
              },
              {
                "title": "Departments",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Departments",
                    "order": 1
                  }
                }
              },
              {
                "title": "Classes",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Classes",
                    "order": 2
                  }
                }
              },
              {
                "title": "Customers",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Customers",
                    "order": 3
                  }
                }
              },
              {
                "title": "Vendors",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Vendors",
                    "order": 4
                  }
                }
              }
            ]
          }
        }
      },
      "profit_loss_settings": {
        "order": 5,
        "title": "Balance Sheet Report settings",
        "type": "object",
        "group": "profit_loss_settings",
        "properties": {
          "summarize_column": {
            "title": "Summarize Column By",
            "description": "The first dimension criteria which defines how to group the report results.",
            "type": "object",
            "display_type": "dropdown",
            "order": 1,
            "oneOf": [
              {
                "title": "None",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "None",
                    "order": 0
                  }
                }
              },
              {
                "title": "Departments",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Departments",
                    "order": 1
                  }
                }
              },
              {
                "title": "Classes",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Classes",
                    "order": 2
                  }
                }
              },
              {
                "title": "Customers",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Customers",
                    "order": 3
                  }
                }
              },
              {
                "title": "Vendors",
                "properties": {
                  "selected_first_dimension": {
                    "type": "string",
                    "const": "Vendors",
                    "order": 4
                  }
                }
              }
            ]
          },
          "second_dimension": {
            "title": "Second Dimension",
            "description": "Secondary dimension to further break down the report results. Requires Summarize Column By to be set to a value other than None.",
            "type": "object",
            "display_type": "dropdown",
            "order": 2,
            "oneOf": [
              {
                "title": "None",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "None",
                    "order": 0
                  }
                }
              },
              {
                "title": "Departments",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Departments",
                    "order": 1
                  }
                }
              },
              {
                "title": "Classes",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Classes",
                    "order": 2
                  }
                }
              },
              {
                "title": "Customers",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Customers",
                    "order": 3
                  }
                }
              },
              {
                "title": "Vendors",
                "properties": {
                  "selected_second_dimension": {
                    "type": "string",
                    "const": "Vendors",
                    "order": 4
                  }
                }
              }
            ]
          }
        }
      },
      "start_date": {
        "order": 6,
        "type": "string",
        "title": "Start Date",
        "description": "The start date of the report, in the format 2021-01-25T00:00:00Z. start_date must be less than end_date.",
        "examples": ["2021-01-25T00:00:00Z"],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
        "format": "date-time",
        "group": "date_settings"
      },
      "end_date": {
        "order": 7,
        "type": "string",
        "title": "End Date",
        "description": "The end date of the report, in the format 2025-01-25T00:00:00Z. end_date must be greater than start_date.",
        "examples": ["2025-01-25T00:00:00Z"],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
        "format": "date-time",
        "group": "date_settings"
      }
    },
    "groups": [
      {
        "id": "base_settings",
        "title": "Base Settings",
        "order": 1
      },
      {
        "id": "balance_sheet_settings",
        "title": "Balance Sheet Report settings",
        "order": 2
      },
      {
        "id": "profit_loss_settings",
        "title": "Profit & Loss Report settings",
        "order": 3
      },
      {
        "id": "date_settings",
        "title": "Date Settings",
        "order": 4
      }
    ]
  }
}
